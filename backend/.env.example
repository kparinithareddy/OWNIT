# ==========================================
# OWNIT Backend Environment Configuration
# ==========================================

# Server Settings
PROJECT_NAME=OWNIT
PROJECT_TAGLINE="Own More. Worry Less."
VERSION=0.1.0
ENVIRONMENT=development
HOST=127.0.0.1
PORT=8000
DEBUG=true

# API Versioning Prefix
API_V1_PREFIX=/api/v1

# CORS Settings (Comma-separated list of allowed frontend origins)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=OWNIT
MONGODB_TIMEOUT_MS=3000
MONGODB_MAX_POOL_SIZE=10
MONGODB_MIN_POOL_SIZE=1

# Security & Authentication (JWT - for future modules)
JWT_SECRET_KEY=change_this_to_a_secure_random_key_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OCR & AI Settings (Local services - Ollama LLM & Tesseract OCR)
TESSERACT_CMD_PATH=C:\Program Files\Tesseract-OCR\tesseract.exe
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_SECONDS=30.0

